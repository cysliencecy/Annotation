{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2020",
    "module": "commonjs",
    "resolveJsonModule": true,
    "types": ["miniprogram-api-typings"],
    "skipLibCheck": true
  },
  "include": ["miniprogram/**/*.js", "miniprogram/**/*.d.ts"]
}
