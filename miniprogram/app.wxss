page {
  --ink: #242424;
  --muted: #737373;
  --surface: #ffffff;
  --subtle: #f6f6f6;
  --line: #d8d8d8;
  background: #ffffff;
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 14px;
  line-height: 1.5;
}
button { box-sizing: border-box; }
button::after { border: 0; }
