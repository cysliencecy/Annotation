page {
  --ink: #242424;
  --muted: #666e68;
  --surface: #ffffff;
  --subtle: #f3f5f1;
  --line: #d7ddd7;
  background: #f7f8f5;
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 14px;
  line-height: 1.5;
}
button { box-sizing: border-box; }
button::after { border: 0; }
