.result-page { padding: 24px 16px 32px; }
.intro { margin-bottom: 16px; }
.eyebrow { font-size: 12px; font-weight: 600; color: var(--muted); }
.page-heading { margin-top: 4px; font-size: 24px; font-weight: 700; }
.scope-note { margin-top: 8px; font-size: 12px; color: var(--muted); }
.photo-stage { position: relative; border-radius: 16px; overflow: hidden; background: var(--subtle); }
.photo { display: block; width: 100%; }
.word-label {
  position: absolute;
  z-index: 1;
  transform: translate(-50%, -50%);
  padding: 5px 8px;
  margin: 0;
  min-width: 0;
  border: 1px solid;
  border-radius: 8px;
  background: var(--surface);
  font-size: 12px;
  font-weight: 600;
  line-height: 16px;
  white-space: nowrap;
}
.word-label--right { left: auto !important; right: 0; transform: translateY(-50%); }
.photo-caption { margin-top: 12px; font-size: 12px; font-weight: 600; }
.tap-hint { margin: 8px 0 16px; color: var(--muted); font-size: 12px; }
.card-placeholder { padding: 16px; min-height: 96px; border-radius: 8px; background: var(--surface); }
.placeholder-title { font-size: 16px; font-weight: 600; }
.placeholder-copy { margin-top: 8px; font-size: 14px; color: var(--muted); }
.provenance-note { margin-top: 24px; font-size: 12px; color: var(--muted); }
.meaning-card { position: relative; padding: 16px; border: 1px solid; border-radius: 8px; background: var(--surface); }
.card-english { font-size: 24px; font-weight: 700; padding-right: 48px; }
.card-chinese { margin-top: 8px; font-size: 16px; font-weight: 600; }
.card-description { margin-top: 8px; color: var(--muted); font-size: 14px; }
.card-close { position: absolute; top: 8px; right: 8px; padding: 8px; margin: 0; background: var(--subtle); color: var(--ink); font-size: 12px; line-height: 24px; border-radius: 8px; }
